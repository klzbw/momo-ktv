#!/bin/bash
source "$(dirname "$0")/lib_settings.sh"

# 应用数据和 MV 曲库已取消自定义路径功能，统一固定使用应用默认共享目录
# /vol1/@appshare/${TRIM_APPNAME} 下的 data、mv 两个子目录（对应
# config/resource 中声明的 momo-ktv/data、momo-ktv/mv 共享）。这里提前
# mkdir 一次，避免共享目录尚未创建完成时 docker compose 首次启动挂载报错。
mkdir -p "$(default_data_path)"
mkdir -p "$(default_mv_path)"
# AI 模型缓存目录（本机 AI 模式时挂给 ai-worker，约 3GB 模型只下载一次）
mkdir -p "$(default_data_path)/ai-models"

# 端口（固定 8083）和管理员密码（首次打开「曲库管理」时自行设置，保存在
# /data 下的 SQLite 里）都不再需要安装向导收集，也就不需要在这里做任何
# 校验或持久化了。

exit 0
