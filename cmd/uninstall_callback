#!/bin/bash
# 卸载后执行：按 compose 声明清理镜像；按卸载向导选择是否清空 MV 曲库（应用数据始终保留）。
source "$(dirname "$0")/lib_settings.sh"

if [ -d "${TRIM_APPDEST}/docker" ]; then
    cd "${TRIM_APPDEST}/docker" && docker compose down --rmi all 2>/dev/null || true
fi

if [ "${wizard_clear_mv}" = "true" ]; then
    MV_DIR="$(default_mv_path)"
    if [ -d "$MV_DIR" ]; then
        find "$MV_DIR" -mindepth 1 -delete 2>/dev/null || true
    fi
fi

exit 0
