#!/bin/bash
source "$(dirname "$0")/lib_settings.sh"

# 之前这里硬编码过具体镜像 tag（例如 momo-ktv:1.3.0），每次版本号变化都要
# 手动同步，很容易忘记导致卸载残留旧镜像。改用 docker compose down --rmi all
# 直接按 compose 文件里声明的镜像清理，不用再关心具体版本号。
if [ -d "${TRIM_APPDEST}/docker" ]; then
    cd "${TRIM_APPDEST}/docker" && docker compose down --rmi all 2>/dev/null || true
fi

# 根据卸载向导（wizard/uninstall）中的选择，决定是否清空 MV 曲库文件。
# 应用数据（数据库、封面等）始终保留，不受这个开关影响——只有 MV 曲库这类
# 体积大、可以重新导入的内容才提供"顺手清空"的选项。容器已经在上面停止，
# 这里删除文件不会影响正在播放/扫描的进程。
# 只清空目录内容，不删除目录本身，避免破坏 config/resource 中声明的共享
# 目录（该目录仍需要保留给下一次安装或用户在文件管理器里继续使用）。
if [ "${wizard_clear_mv}" = "true" ]; then
    MV_DIR="$(default_mv_path)"
    if [ -d "$MV_DIR" ]; then
        find "$MV_DIR" -mindepth 1 -delete 2>/dev/null || true
    fi
fi

exit 0
