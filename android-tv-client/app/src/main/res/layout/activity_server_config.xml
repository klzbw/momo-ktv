<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center">

    <LinearLayout
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_dark"
        android:padding="36dp"
        android:layout_centerInParent="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_config_title"
            android:textColor="@color/text_white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/server_config_subtitle"
            android:textColor="@color/text_sub"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_hint"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_sub"
            android:textSize="16sp"
            android:background="#1A1A3A"
            android:padding="14dp"
            android:inputType="textUri"
            android:importantForAutofill="no"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_button"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@color/accent_cyan"
            android:padding="14dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_pink"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:minHeight="20dp" />

    </LinearLayout>

</RelativeLayout>
